# Configurações do Supabase
# URL do projeto (https://app.supabase.com/project/<id>/settings/api)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon (pode ser exposta no client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (usada em links de e-mail, ex: confirmação de conta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000